"vet6\stm32f1xx_hal.o"
"vet6\stm32f1xx_hal_rcc.o"
"vet6\stm32f1xx_hal_rcc_ex.o"
"vet6\stm32f1xx_hal_gpio.o"
"vet6\stm32f1xx_hal_dma.o"
